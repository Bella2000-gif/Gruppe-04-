# ── Codewörter ───────────────────────────────────────────────────────────
# Damit meldet Marco sich an. Groß-/Kleinschreibung ist egal.
#
# Nimm etwas, das ihr beide kennt und niemand sonst errät — gern mehrere
# Wörter, das merkt sich besser als kryptisches Zeug. Mindestens 10 Zeichen.
# Die Seite weigert sich zu starten, solange hier noch der Beispielwert steht.
MARCO_CODE=bitte-hier-ein-eigenes-wort-fuer-marco-eintragen

# Bellas Zugang: sie darf alle Briefe schon vorher lesen (Vorschau) und mit
# der Zeitreise oben rechts prüfen, wie die Seite in einem späteren Monat
# aussieht. Das zählt nicht als „geöffnet“. Muss sich von MARCO_CODE
# unterscheiden.
BELLA_CODE=bitte-hier-ein-eigenes-wort-fuer-bella-eintragen

# ── Sicherheit ───────────────────────────────────────────────────────────
# Unterschreibt das Anmelde-Cookie. Eine lange Zufallszeichenkette,
# mindestens 24 Zeichen. Erzeugen mit:
#
#     openssl rand -base64 32
#
SESSION_SECRET=bitte-hier-eine-lange-zufallszeichenkette-eintragen

# ── Speicher ─────────────────────────────────────────────────────────────
# Nur EINES von beiden setzen.
#
# a) Hoster mit eigener Festplatte (Raspberry Pi, kleiner Server, lokal):
#    nichts setzen — dann liegt alles in ./data/briefe.db
#    Wer die Datei woanders haben will:
# DATABASE_PATH=/var/data/briefe.db
#
# b) Serverlose Hoster (Vercel, Netlify): dort ist die Festplatte flüchtig,
#    also braucht es eine Datenbank daneben. Die Verbindungszeichenkette
#    bekommst du bei Neon, Supabase, Railway … Sobald sie gesetzt ist,
#    benutzt die App automatisch Postgres statt SQLite.
# DATABASE_URL=postgresql://benutzer:passwort@host/datenbank?sslmode=require
